<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <AssemblyName>ThumbHashSharp</AssemblyName>
    <RootNamespace>ThumbHashSharp</RootNamespace>

    <PackageId>ThumbHashSharp</PackageId>
    <Version>2.0.0</Version>
    <Authors>SunSi</Authors>
    <Description>A dependency-free C# implementation of ThumbHash with configurable large-image resizing.</Description>
    <PackageTags>thumbhash;image;placeholder;blurhash;rgba</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SunSi12138/ThumbHashSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="..\LICENSE" Pack="true" PackagePath="/" Link="LICENSE" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Link="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

</Project>
